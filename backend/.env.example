DATABASE_URL=postgresql+psycopg2://postgres:[Password]@localhost:5432/smart_hospital
CROWD_THRESHOLD=5
CAMERA_INDEX=0
UPDATE_INTERVAL=0.5
BACKEND_URL=http://127.0.0.1:8000
ADMIN_TOKEN_SECRET=replace-with-a-long-random-secret
CAMERA_AGENT_TOKEN=replace-with-a-separate-camera-agent-token
CAMERA_STALE_AFTER_SECONDS=15
CROWD_READING_STALE_AFTER_SECONDS=30
CAMERA_HEARTBEAT_INTERVAL=5
CAMERA_RECONNECT_ATTEMPTS=5
CAMERA_RECONNECT_DELAY=2
CAMERA_RESTART_DELAY=10
FRAME_STREAM_INTERVAL=0.2
FRAME_JPEG_QUALITY=75
FRAME_STREAM_INTERVAL_SECONDS=0.15
FRAME_STREAM_IDLE_TIMEOUT_SECONDS=30
